#include <stdio.h>

struct polynomial
{
    int coeff;
    int expo;
};

int main()
{
    struct polynomial p1[10], p2[10], p3[20];
    int n1, n2, n3 = 0;
    int i = 0, j = 0;

    printf("Enter the number of terms in first polynomial: ");
    scanf("%d", &n1);

    printf("Enter the coefficient and exponent:\n");
    for (i = 0; i < n1; i++)
    {
        scanf("%d%d", &p1[i].coeff, &p1[i].expo);
    }

    printf("Enter the number of terms in second polynomial: ");
    scanf("%d", &n2);

    printf("Enter the coefficient and exponent:\n");
    for (i = 0; i < n2; i++)
    {
        scanf("%d%d", &p2[i].coeff, &p2[i].expo);
    }

    i = 0;
    j = 0;

    while (i < n1 && j < n2)
    {
        if (p1[i].expo == p2[j].expo)
        {
            p3[n3].coeff = p1[i].coeff + p2[j].coeff;
            p3[n3].expo = p1[i].expo;
            i++;
            j++;
            n3++;
        }
        else if (p1[i].expo > p2[j].expo)
        {
            p3[n3] = p1[i];
            i++;
            n3++;
        }
        else
        {
            p3[n3] = p2[j];
            j++;
            n3++;
        }
    }

    while (i < n1)
    {
        p3[n3] = p1[i];
        i++;
        n3++;
    }

    while (j < n2)
    {
        p3[n3] = p2[j];
        j++;
        n3++;
    }

    printf("\nResultant Polynomial:\n");

    for (i = 0; i < n3; i++)
    {
        printf("%dx^%d", p3[i].coeff, p3[i].expo);

        if (i < n3 - 1)
            printf(" + ");
    }

    return 0;
}
