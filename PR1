#include <stdio.h>
#include <stdlib.h>

#define MAX 100

// Function declarations
void create(int arr[], int *n);
void display(int arr[], int n);
void insert(int arr[], int *n);
void delete_element(int arr[], int *n);
void search(int arr[], int n);

int main()
{
    int arr[MAX];
    int n = 0;
    int choice;

    while (1)
    {
        printf("\n==================================\n");
        printf("       ARRAY OPERATIONS MENU\n");
        printf("==================================\n");
        printf("1. Create/Initialize Array\n");
        printf("2. Display Array\n");
        printf("3. Insert Element\n");
        printf("4. Delete Element\n");
        printf("5. Search Element (Linear Search)\n");
        printf("6. Exit\n");

        printf("\nEnter your choice (1-6): ");

        if (scanf("%d", &choice) != 1)
        {
            printf("Invalid input! Please enter a number.\n");

            while (getchar() != '\n');

            continue;
        }

        switch (choice)
        {
            case 1:
                create(arr, &n);
                break;

            case 2:
                display(arr, n);
                break;

            case 3:
                insert(arr, &n);
                break;

            case 4:
                delete_element(arr, &n);
                break;

            case 5:
                search(arr, n);
                break;

            case 6:
                printf("\nExiting program. Thank you!\n");
                exit(0);

            default:
                printf("Invalid choice! Please select a valid option (1-6).\n");
        }
    }

    return 0;
}

// 1. Create Array Operation
void create(int arr[], int *n)
{
    int i;

    printf("\nEnter the number of elements to initialize (Max %d): ", MAX);

    if (scanf("%d", n) != 1)
    {
        printf("Invalid input.\n");
        *n = 0;
        return;
    }

    if (*n < 0 || *n > MAX)
    {
        printf("Error: Size must be between 1 and %d.\n", MAX);
        *n = 0;
        return;
    }

    printf("Enter %d integers:\n", *n);

    for (i = 0; i < *n; i++)
    {
        printf("Element [%d]: ", i);
        scanf("%d", &arr[i]);
    }

    printf("\nArray initialized successfully!\n");
}

// 2. Display Array Operation
void display(int arr[], int n)
{
    int i;

    if (n == 0)
    {
        printf("\nArray is empty! Nothing to display.\n");
        return;
    }

    printf("\nArray Elements: ");

    for (i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    printf("\nTotal elements: %d\n", n);
}

// 3. Insert Element Operation
void insert(int arr[], int *n)
{
    int i, pos, val;

    if (*n >= MAX)
    {
        printf("\nError: Array Overflow! Cannot insert more elements.\n");
        return;
    }

    printf("\nEnter the element to insert: ");
    scanf("%d", &val);

    printf("Enter the position (0 to %d) where you want to insert: ", *n);
    scanf("%d", &pos);

    if (pos < 0 || pos > *n)
    {
        printf("Invalid position! Valid positions are from 0 to %d.\n", *n);
        return;
    }

    // Shift elements to the right
    for (i = *n - 1; i >= pos; i--)
    {
        arr[i + 1] = arr[i];
    }

    arr[pos] = val;
    (*n)++;

    printf("Element %d successfully inserted at position %d.\n",
           val, pos);
}

// 4. Delete Element Operation
void delete_element(int arr[], int *n)
{
    int i, pos, val;

    if (*n == 0)
    {
        printf("\nError: Array Underflow! No elements to delete.\n");
        return;
    }

    printf("\nEnter the position (0 to %d) of the element to delete: ",
           *n - 1);
    scanf("%d", &pos);

    if (pos < 0 || pos >= *n)
    {
        printf("Invalid position! Valid positions are from 0 to %d.\n",
               *n - 1);
        return;
    }

    val = arr[pos];

    // Shift elements to the left
    for (i = pos; i < *n - 1; i++)
    {
        arr[i] = arr[i + 1];
    }

    (*n)--;

    printf("Element %d successfully deleted from position %d.\n",
           val, pos);
}

// 5. Search Element Operation
void search(int arr[], int n)
{
    int i, key, found = 0;

    if (n == 0)
    {
        printf("\nArray is empty! Cannot search.\n");
        return;
    }

    printf("\nEnter the element to search: ");
    scanf("%d", &key);

    for (i = 0; i < n; i++)
    {
        if (arr[i] == key)
        {
            printf("Element %d found at position (index) %d.\n",
                   key, i);

            found = 1;
            break;
        }
    }

    if (!found)
    {
        printf("Element %d not found in the array.\n", key);
    }
}
